.toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx 4rpx;
}
.toolbar-family { font-size: 36rpx; font-weight: 700; }
.toolbar-sub { margin-top: 6rpx; display: flex; align-items: center; }
.toolbar-right { display: flex; align-items: center; }
.tool-btn {
  background: #fff;
  border: 1rpx solid #ece8e0;
  color: #5c564d;
  font-size: 26rpx;
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  margin-left: 14rpx;
  display: flex;
  align-items: center;
  line-height: 1.4;
}
.tool-share {
  color: #07c160;
  border-color: #07c160;
  padding: 10rpx 24rpx;
}
.tool-share::after { border: none; }

/* 近期寿星横幅 */
.bd-banner {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  margin: 12rpx 24rpx 0;
  background: #fffdf6;
  border: 1rpx solid #f0dcb4;
  border-radius: 14rpx;
  padding: 14rpx 20rpx;
  font-size: 24rpx;
}
.bd-icon { margin-right: 8rpx; }
.bd-label { color: #6b655c; margin-right: 8rpx; }
.bd-item {
  color: #a4762a;
  margin-right: 16rpx;
  text-decoration: underline;
}

.tree-scroll {
  width: 100%;
  height: calc(100vh - 160rpx);
}
.tree-canvas {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  min-width: 100%;
  padding: 50rpx 40rpx 120rpx;
  box-sizing: border-box;
}
.tree-root {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 60rpx;
}
