.tv-scroll { width: 100%; height: 100vh; }
.tv-canvas {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  min-width: 100%;
  padding: 50rpx 40rpx 120rpx;
  box-sizing: border-box;
}
.tv-root {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
}
.tv-root-hint {
  color: #a4762a;
  font-size: 24rpx;
  margin-bottom: 30rpx;
  background: #f7efdd;
  padding: 8rpx 28rpx;
  border-radius: 999rpx;
}
