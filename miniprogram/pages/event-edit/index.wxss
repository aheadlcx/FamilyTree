.ee-images { display: flex; flex-wrap: wrap; }
.ee-img-wrap { position: relative; margin: 0 16rpx 16rpx 0; }
.ee-img { width: 180rpx; height: 180rpx; border-radius: 12rpx; }
.ee-img-del {
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  width: 36rpx;
  height: 36rpx;
  line-height: 34rpx;
  text-align: center;
  border-radius: 50%;
  background: #e64340;
  color: #fff;
  font-size: 22rpx;
}
.ee-img-add {
  width: 180rpx;
  height: 180rpx;
  border: 2rpx dashed #c9c2b8;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #b5aea3;
  font-size: 60rpx;
}
